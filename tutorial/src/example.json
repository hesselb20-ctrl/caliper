  "modelSource": [
    "def build(P):",
    "    \"\"\"Build the part from a flat parameter dict (millimetres).\"\"\"",
    "    L, W, T = P[\"base.length\"], P[\"base.width\"], P[\"base.thickness\"]",
    "",
    "    # base: base plate, centred on the origin, sitting on Z = 0",
    "    part = cq.Workplane(\"XY\").box(L, W, T, centered=(True, True, False))",
    "",
    "    # fillet: rounded plate corners (free)",
    "    r = P[\"fillet.radius\"]",
    "    for sx, sy in [(-1, -1), (1, -1)]:",
    "        cx, cy = sx * L / 2, sy * W / 2",
    "        corner = cq.selectors.BoxSelector((cx - 0.1, cy - 0.1, -0.1), (cx + 0.1, cy + 0.1, T + 0.1))",
    "        part = part.edges(corner).fillet(r)",
    "",
    "    # flange: flange standing on the +y edge (height from Z = 0)",
    "    fh, ft = P[\"flange.height\"], P[\"flange.thickness\"]",
    "    part = part.union(cq.Workplane(\"XY\").box(L, ft, fh, centered=(True, True, False)).translate((0, (W / 2 - ft / 2), 0)))",
    "",
    "    # h1: through hole in the base",
    "    part = part.cut(cq.Solid.makeCylinder(P[\"h1.diameter\"] / 2, T + 2, cq.Vector(P[\"h1.x\"], P[\"h1.y\"], -1), cq.Vector(0, 0, 1)))",
    "",
    "    # h2: through hole in the base"
  ],
