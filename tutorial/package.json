{
  "name": "caliper-tutorial",
  "version": "0.1.0",
  "private": true,
  "description": "The caliper tutorial video, built in code with Remotion.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "frames": "remotion render src/index.ts Tutorial out/frames --sequence --image-format=jpeg --jpeg-quality=95",
    "render": "npm run frames && node encode.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
